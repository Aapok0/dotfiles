#!/usr/bin/env bash
# Run container-based smoke tests locally.
#
# Usage:
#   tests/run.sh [tier] [distro...]
#     tier    lint-tools              (default: lint-tools)
#     distro  arch | debian | fedora   (default: all three)
#
# Container runtime is taken from $RUNTIME (default: docker). It may contain
# arguments, e.g. RUNTIME="sudo docker" tests/run.sh
set -euo pipefail
cd "$(dirname "$0")/.."

read -r -a runtime <<<"${RUNTIME:-docker}"
tier=${1:-lint-tools}
shift || true
distros=("$@")
[ ${#distros[@]} -gt 0 ] || distros=(debian fedora arch)

declare -A IMG=(
    [debian]=debian:stable
    [fedora]=fedora:latest
    [arch]=archlinux:latest
)

declare -A SCRIPT=(
    [lint-tools]=lint-tools-smoke.sh
)

script=${SCRIPT[$tier]:?unknown tier: $tier (use lint-tools)}

rc=0
for d in "${distros[@]}"; do
    img=${IMG[$d]:?unknown distro: $d (use arch|debian|fedora)}
    echo "==================== $d ($img) / $tier ===================="
    # ':z' relabels the bind mount for SELinux hosts; harmless elsewhere.
    "${runtime[@]}" run --rm -v "$PWD:/repo:ro,z" "$img" \
        bash "/repo/tests/$script" "$d" || rc=1
done

exit "$rc"
